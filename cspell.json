{
  "version": "0.2",
  "language": "en-US,en-GB",
  "dictionaries": [
    "python",
    "python-common",
    "bash"
  ],
  "useGitignore": true,
  "files": [
    "*.md",
    "cli/**/*.py",
    "cli/*.md",
    "workflows/src/**/*.py",
    "workflows/src/**/OVERVIEW.md",
    ".agents/skills/**/*.md",
    ".github/workflows/*.yml",
    "pyproject.toml",
    "Makefile",
    ".githooks/pre-commit",
    "conftest.py",
    "cspell.json"
  ],
  "ignorePaths": [
    "**/.git/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "cli/schemas/**",
    "uv.lock",
    "local/**",
    "**/.env",
    "**/.env.*",
    "**/*.env",
    "**/*.env.*",
    "**/*.{key,pem,p12,pfx,crt}",
    "**/artefacts/vari/**"
  ],
  "ignoreRegExpList": [
    "/\\\\[nrt]/g",
    "/%[0-9A-Fa-f]{2}/g"
  ],
  "words": [
    "addopts",
    "apikey",
    "appkey",
    "artefacts",
    "asname",
    "autouse",
    "capsys",
    "clientsecret",
    "dedupe",
    "delenv",
    "deployables",
    "dotenv",
    "elts",
    "ENVPATH",
    "executionid",
    "fromlist",
    "GeoNames",
    "kwonlyargs",
    "LASTEXITCODE",
    "Meteo",
    "modifyitems",
    "mulesoft",
    "noauth",
    "nonprod",
    "NOSYSTEM",
    "polyapi",
    "posonlyargs",
    "preprod",
    "pypirc",
    "pytestmark",
    "readback",
    "subpaths",
    "syspath",
    "Tabi",
    "tabis",
    "testpaths",
    "timespec",
    "timestamptz",
    "truststore",
    "unawaited",
    "unconfigured",
    "unsuffixed",
    "upserts",
    "vararg",
    "Vari",
    "writeback",
    "xcorrelationid"
  ]
}
