# Placeholders only. Copy to workflows/dev.env and fill values locally.
POLYAPI_NAMESPACE=example
POLY_API_BASE_URL=https://replace-with-instance.polyapi.io
POLY_API_KEY=replace-with-environment-api-key
TARGET_ENV_ID=replace-with-environment-id

# Server-function execution key; required when production safeguards apply.
# POLY_EXEC_API_KEY=replace-with-execution-api-key

# Match these bindings to your actual Git/environment layout.
GIT_PROD_BRANCH=main:workflows/prod.env
GIT_PROD_SKIP_BRANCHES=develop:workflows/dev.env
POLY_DEPLOY_PRIORITY_PATHS=workflows/src/utilities

# Optional deployed sample QA; ignored by Flow. Copy the deployed webhook URL
# from PolyAPI/Canopy, including its environment subdomain.
POLY_TEST_WEBHOOK_URL=https://replace-with-environment.replace-with-instance.polyapi.io/apis/example-motd/motd

# Common utility configuration (non-secret placeholders)
LOG_LEVEL=debug
SLACK_CHANNEL_ID=replace-with-your-channel-id
