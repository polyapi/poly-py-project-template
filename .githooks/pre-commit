#!/usr/bin/env python3
"""Run the project's checks before Git creates a commit."""

from pathlib import Path
import subprocess
import sys


def main() -> int:
    repo_root = Path(__file__).resolve().parents[1]
    try:
        return subprocess.run(["make", "check"], cwd=repo_root, check=False).returncode
    except FileNotFoundError:
        print("pre-commit: make is required to run make check.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
