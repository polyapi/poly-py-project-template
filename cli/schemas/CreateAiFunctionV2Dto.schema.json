{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/components/schemas/CreateAiFunctionV2Dto",
  "components": {
    "schemas": {
      "CreateAiFunctionV2Dto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "systemPrompt": {
            "type": "string"
          },
          "systemPromptVariableId": {
            "type": "string"
          },
          "inputTemplate": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "returnType": {
            "type": [
              "string",
              "null"
            ]
          },
          "returnTypeSchema": {
            "type": [
              "object",
              "null"
            ]
          },
          "outputSchema": {
            "type": [
              "object",
              "null"
            ]
          },
          "errorSchema": {
            "type": [
              "object",
              "null"
            ],
            "nullable": true
          },
          "toolFunctionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "toolFunctions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "clientPromptEnabled": {
            "type": "boolean"
          },
          "clientPromptRequired": {
            "type": "boolean"
          },
          "clientPromptArgName": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "type": {
            "type": "string"
          },
          "voiceConnectProvider": {
            "type": "string"
          },
          "voiceOutput": {
            "type": "string",
            "enum": [
              "ALLOY",
              "ASH",
              "BALLAD",
              "CORAL",
              "ECHO",
              "SAGE",
              "SHIMMER",
              "VERSE"
            ]
          },
          "voiceInitialMessage": {
            "type": [
              "string",
              "null"
            ],
            "nullable": true,
            "maxLength": 500
          },
          "twilioAuthTokenVariableId": {
            "type": [
              "string",
              "null"
            ],
            "nullable": true,
            "description": "Voice functions only. The id of a SECRET variable in this function's environment that holds your own Twilio\nauth token, used to verify Twilio's webhook signature. Omit it to use the platform's Twilio credentials."
          },
          "router": {
            "type": "boolean"
          },
          "routerServerFunctionId": {
            "type": "string"
          },
          "apiType": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "context"
        ]
      }
    }
  }
}
